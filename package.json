{
	"name": "nicktrombley.design",
	"version": "3.0.0",
	"description": "Portfolio website of Nick Trombley, a software designer/engineer based in Boston.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node .prerender/entry-server.js",
		"preview": "vite preview",
		"check": "tsc --noEmit",
		"lint": "oxlint --deny-warnings && oxfmt --check",
		"format": "oxfmt --write"
	},
	"dependencies": {
		"@fontsource-variable/inter": "~5.3.0",
		"@stylexjs/stylex": "~0.19.0",
		"d3-hierarchy": "~3.1.2",
		"d3-shape": "~3.2.0",
		"react": "~19.2.8",
		"react-dom": "~19.2.8"
	},
	"devDependencies": {
		"@babel/core": "~7.29.7",
		"@rolldown/plugin-babel": "~0.2.3",
		"@stylexjs/babel-plugin": "~0.19.0",
		"@stylexjs/eslint-plugin": "~0.19.0",
		"@stylexjs/postcss-plugin": "~0.19.0",
		"@types/babel__core": "~7.20.5",
		"@types/babel__traverse": "~7.28.0",
		"@types/d3-hierarchy": "~3.1.7",
		"@types/d3-shape": "~3.2.0",
		"@types/node": "~26.4.1",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.7",
		"@vitejs/plugin-react": "~6.1.1",
		"oxfmt": "~0.66.0",
		"oxlint": "~1.81.0",
		"oxlint-tsgolint": "~7.0.2001",
		"postcss": "~8.5.28",
		"typescript": "~7.0.2",
		"vite": "~8.0.16"
	},
	"browserslist": [
		"last 2 Chrome versions",
		"last 2 Firefox versions",
		"last 2 Safari versions"
	],
	"packageManager": "pnpm@10.30.1"
}
