{
	"name": "nicktrombley.design",
	"description": "Portfolio website of Nick Trombley, a software designer/engineer based in Boston.",
	"version": "3.0.0",
	"packageManager": "pnpm@10.30.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"process-svgs": "bun scripts/process-svgs.ts"
	},
	"dependencies": {
		"remarkable": "~2.0.1",
		"remarkable-meta": "~1.0.1",
		"zod": "~4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "~10.0.1",
		"@sveltejs/adapter-static": "~3.0.10",
		"@sveltejs/kit": "~2.66.0",
		"@sveltejs/vite-plugin-svelte": "~7.1.2",
		"@types/jsdom": "~28.0.3",
		"@types/remarkable": "~2.0.8",
		"csv-parse": "~7.0.0",
		"eslint": "~10.5.0",
		"eslint-config-prettier": "~10.1.8",
		"eslint-plugin-svelte": "~3.19.0",
		"glob": "~13.0.6",
		"globals": "~17.6.0",
		"jsdom": "~29.1.1",
		"prettier": "~3.8.4",
		"prettier-plugin-svelte": "~4.1.1",
		"svelte": "~5.56.3",
		"svelte-check": "~4.6.0",
		"svgo": "~4.0.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "~8.61.1",
		"vite": "~8.0.16"
	}
}
