{
	"name": "nicktrombley.design",
	"description": "Portfolio website of Nick Trombley, a software designer/engineer based in Boston.",
	"version": "3.0.0",
	"packageManager": "pnpm@10.30.1",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#components/*": "./src/components/*",
		"#types/*": "./src/types/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"process-svgs": "bun scripts/process-svgs.ts"
	},
	"dependencies": {
		"remarkable": "~2.0.1",
		"remarkable-meta": "~1.0.1",
		"zod": "~4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "~10.0.1",
		"@sveltejs/adapter-static": "~4.0.1",
		"@sveltejs/kit": "~3.1.1",
		"@sveltejs/vite-plugin-svelte": "~7.3.1",
		"@types/jsdom": "~30.0.0",
		"@types/remarkable": "~2.0.8",
		"@typescript/native": "npm:typescript@~7.0.2",
		"csv-parse": "~7.0.3",
		"eslint": "~10.14.0",
		"eslint-config-prettier": "~10.1.8",
		"eslint-plugin-svelte": "~3.23.1",
		"glob": "~14.0.3",
		"globals": "~17.13.0",
		"jsdom": "~30.1.3",
		"prettier": "~3.9.10",
		"prettier-plugin-svelte": "~4.1.1",
		"svelte": "~5.57.3",
		"svelte-check": "~4.7.7",
		"svgo": "~4.1.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "~8.72.1",
		"vite": "~8.3.5"
	}
}
