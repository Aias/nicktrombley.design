{
	"plugins": {
		"@stylexjs/postcss-plugin": {
			"include": ["./src/**/*.{ts,tsx}"],
			"useCSSLayers": true,
			"babelConfig": {
				"parserOpts": {
					"plugins": ["typescript", "jsx"]
				},
				"plugins": [
					[
						"@stylexjs/babel-plugin",
						{
							"dev": false,
							"runtimeInjection": false,
							"treeshakeCompensation": true,
							"unstable_moduleResolution": {
								"type": "commonJS"
							}
						}
					]
				]
			}
		}
	}
}
